# ---------------------------------------------------------------------------
# Copy this file to `.env` and edit it. `.env` is gitignored — real keys
# never belong in the repository.
#   cp .env.example .env
# Values already set in the shell always win over this file.
# ---------------------------------------------------------------------------

# Port the order API listens on. Must match the ORDER_API_BASE the app was
# built with (default http://10.0.2.2:8080 → 8080).
PORT=8080

# --- Firebase credentials: pick exactly ONE of the blocks below ------------

# A) Recommended: path to the service-account JSON downloaded from
#    Firebase console → Project settings → Service accounts →
#    "Generate new private key". Relative paths resolve from backend/.
#    Save the file as backend/serviceAccountKey.json (gitignored).
SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# B) The same key pasted inline as one line — handy on hosts where you
#    cannot upload files. Takes precedence over SERVICE_ACCOUNT_KEY.
# SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"coffee-shop-roknn","private_key_id":"…","private_key":"-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-…@coffee-shop-roknn.iam.gserviceaccount.com"}

# C) Standard Google application-default credentials
#    (`gcloud auth application-default login`). Comment out A and B to use it.
# GOOGLE_APPLICATION_CREDENTIALS=C:/keys/coffee-shop-roknn.json
