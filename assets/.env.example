# Firebase options for the app — copy to assets/.env (gitignored):
#   cp assets/.env.example assets/.env
#
# Values come from Firebase console → Project settings → General →
# "Your apps" (or `flutterfire configure`). They are public identifiers, not
# secrets: every app ships them in its binary. This file is the only place
# they are written — lib/firebase_options.dart does not exist anymore, and
# FirebaseEnv.options throws a clear error when a key below is missing.

FIREBASE_API_KEY=YOUR_WEB_API_KEY
FIREBASE_APP_ID=1:PROJECT_NUMBER:android:APP_ID
FIREBASE_MESSAGING_SENDER_ID=PROJECT_NUMBER
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
